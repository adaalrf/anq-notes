{
    admin off
    auto_https off
}
:8080 {
    root * /srv/site
    encode gzip
    # The pages fetch nothing, but Lighthouse reads robots.txt from inside the page.
    header {
        Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Cross-Origin-Opener-Policy same-origin
        Cross-Origin-Resource-Policy same-origin
        # The proxy in front adds its own.
        -Server
    }
    # Hashed files never change, so returning visitors needn't ask. Everything else revalidates.
    @fingerprinted {
        file
        path_regexp \.[0-9a-f]{10}\.(css|js|svg|woff2)$
    }
    header @fingerprinted Cache-Control "public, max-age=31536000, immutable"
    header ?Cache-Control "no-cache"
    respond /healthz "ok" 200
    file_server {
        hide .anq-ssg-output
    }
    handle_errors {
        @notfound expression {err.status_code} == 404
        rewrite @notfound /404.html
        file_server
    }
}
